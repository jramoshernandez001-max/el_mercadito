# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL pública del sitio (en Vercel: https://el-mercadito.vercel.app o tu dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del equipo de El Mercadito para reservas de anuncios (10 dígitos)
NEXT_PUBLIC_WHATSAPP_EQUIPO=
